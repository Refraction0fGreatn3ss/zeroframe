# Dev server: proxy /api and /ws to the ZeroFrame backend.
ZEROFRAME_BACKEND_URL=https://zeroframe.example.internal

# Optional overrides when the backend is served from a different origin or path.
VITE_ZEROFRAME_API_URL=/api/v1
VITE_ZEROFRAME_REALTIME_URL=/ws/events

# Build identity, injected by CI.
VITE_BUILD_ID=
VITE_GIT_COMMIT=
